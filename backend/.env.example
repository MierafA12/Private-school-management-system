# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5001

# ─── PostgreSQL / Supabase ──────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase (optional — only needed if using Supabase storage/realtime) ──────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── JWT Secrets — generate strong random strings, keep secret ─────────────────
JWT_SECRET=replace_with_a_long_random_string_32chars
JWT_REFRESH_SECRET=replace_with_another_long_random_string_32chars

# ─── CORS — set to your frontend URL ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Chapa Payment Gateway ──────────────────────────────────────────────────────
# Get from: dashboard.chapa.co → Settings → API Keys
CHAPA_SECRET_KEY=CHASECK_TEST-CZjUwEspRGcj7cY9CKeW0406aSZqepKb
# Get from: dashboard.chapa.co → Settings → Webhooks → Webhook Secret
CHAPA_WEBHOOK_SECRET=EduFlowHaileManas2025School
CHAPA_BASE_URL=https://api.chapa.co/v1
# Your frontend base URL — used to build callback_url and return_url for Chapa
APP_URL=http://localhost:5173

# ─── Seed overrides (optional) ─────────────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@school.com
# SEED_ADMIN_PASSWORD=Admin@1234
# SEED_REGISTRAR_EMAIL=registrar@school.com
# SEED_REGISTRAR_PASSWORD=Reg@1234
